{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {"type": "string", "enum": ["PASS", "NO_PASS"]},
    "checklist": {
      "type": "array",
      "description": "goals_nongoals、approach_alternatives、open_questions、prior_art 看 design.md，没有就看 plan。必填 lowering：审实现或验收材料在 diff 查下调门槛、跳过或删测试、关掉检查（@ts-ignore、eslint-disable、# noqa、XCTSkip、.skip 等）、留桩或半成品、新增没人同意的例外；命中写进 new_issues，方案没明确同意就是 blocking；审纯方案没有 diff 时 status=ok，note=无 diff，不适用。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string"},
          "status": {"type": "string", "enum": ["ok", "weak", "missing"]},
          "note": {"type": "string"}
        },
        "required": ["item", "status", "note"]
      }
    },
    "new_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {"type": "string", "enum": ["blocking", "should", "nit"]},
          "scope": {"type": "string", "enum": ["in", "out"]},
          "title": {"type": "string"},
          "evidence": {"type": "string"},
          "suggestion": {"type": "string"}
        },
        "required": ["severity", "scope", "title", "evidence", "suggestion"]
      }
    },
    "open_issue_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "verdict": {"type": "string", "enum": ["resolved", "still_open", "escalate"]},
          "reason": {"type": "string"}
        },
        "required": ["id", "verdict", "reason"]
      }
    },
    "alternative": {"type": "string"},
    "reply_to_chair": {"type": "string"},
    "questions_for_chair": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["verdict", "checklist", "new_issues", "open_issue_verdicts", "alternative", "reply_to_chair", "questions_for_chair"]
}
