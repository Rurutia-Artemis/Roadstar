#!/usr/bin/env bash
# Offline Grok CLI stub. FAKE_GROK_STATE: logged_in (default) | logged_out | hang | error
set -euo pipefail
trace="${FAKE_TRACE_FILE:-}"
if [[ -n "$trace" ]]; then
  python3 - "$@" <<'TRACE' >> "$trace"
import json, sys
print(json.dumps({"cli": "grok", "args": sys.argv[1:]}, separators=(",", ":")))
TRACE
fi
if [[ "${1:-}" == -p ]]; then
  sleep "${FAKE_GROK_DELAY:-0}"
  if [[ "${FAKE_GROK_EXIT:-0}" != 0 ]]; then echo 'stub Grok failure' >&2; exit "$FAKE_GROK_EXIT"; fi
  printf '%s' "$2"
  exit 0
fi
[[ "${1:-}" == models ]] || { echo "unsupported: $*" >&2; exit 2; }
case "${FAKE_GROK_STATE:-logged_in}" in
  logged_in)
    cat <<'TXT'
You are logged in with grok.com.

Default model: grok-4.7

Available models:
  * grok-4.7 (default)
  - grok-4.7-build-fast
  - grok-4.6
  - grok-4.5
TXT
    ;;
  logged_out) echo "You are not logged in. Run 'grok login' first." >&2; exit 1 ;;
  hang) sleep 60 ;;
  error) echo "boom" >&2; exit 3 ;;
esac
