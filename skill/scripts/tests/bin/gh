#!/usr/bin/env python3
"""Offline issue-create stub: record arguments and the exact body before exit."""
import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
assert args[:2] == ["issue", "create"], args
assert "--label" not in args, args
body = Path(args[args.index("--body-file") + 1]).read_text(encoding="utf-8")
trace = os.environ["FAKE_GH_TRACE_FILE"]
with open(trace, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"args": args, "body": body}, ensure_ascii=False) + "\n")
raise SystemExit(int(os.environ.get("FAKE_GH_EXIT", "0")))
